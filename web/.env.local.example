# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> Data API in the Supabase dashboard).
#
# The anon/publishable key is safe to expose to the browser -- the
# eda_samples table only grants it SELECT via the RLS policy in
# supabase/schema.sql.
#
# When deploying on Vercel, set these same two variables under
# Project Settings -> Environment Variables instead of committing this file.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
